# Optional overrides only. Version0.10 starts public+readonly without any of these.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
MCP_AUTH_MODE=public
MCP_PUBLIC_ORIGIN=https://rtalyutin-tg-mcp-8179.twc1.net
MCP_PROFILE=readonly
PUBLISH_ENABLED=false
# Telegram activation is separate; bot token is always required to send.
# MCP_PROFILE=publisher
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# PUBLISH_ENABLED=true
# Existing outreach service with database-backed GitHub Actions delivery:
# OUTREACH_ENABLED=true
# TELEGRAM_ENABLED=true
# MCP_PROFILE=publisher
# TELEGRAM_DELIVERY_MODE=worker
# TELEGRAM_TASK_CHANNELS=6a8ea4143e448191a2832ae794d9e8d1=@talyutinstories
# TELEGRAM_WORKER_TOKEN=<generate a separate random 32+ character secret>
# PUBLISH_ENABLED=false
# Set the same TELEGRAM_WORKER_TOKEN as the GitHub YCS_WORKER_TOKEN secret.
# Set TELEGRAM_BOT_TOKEN only in GitHub Actions for worker mode.
# Optional portfolio module (uses the existing DATABASE_URL; activate after review):
# OWNSITE_ENABLED=true
# OWNSITE_MCP_CREDENTIAL_ID=<UUID of the existing owner's MCP credential>
# If omitted, uses DASHBOARD_SNAPSHOT_MCP_CREDENTIAL_ID.
# No new PostgreSQL instance or public write endpoint is required.
