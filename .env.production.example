# Example only. Set real values in Timeweb environment settings, never commit them.
NODE_ENV=production
HOST=0.0.0.0
PORT=8080
MCP_PROFILE=readonly
PUBLISH_ENABLED=false
MCP_RESOURCE_URL=https://YOUR-APP-DOMAIN/mcp
OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
OAUTH_JWKS_URI=https://YOUR-TENANT.auth0.com/.well-known/jwks.json
OAUTH_ALLOWED_SUBJECT=REPLACE_WITH_OWNER_USER_ID
# Only after approved publisher activation:
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
