NODE_ENV=development
DATABASE_URL=postgresql://workspace:workspace@127.0.0.1:5432/workspace
OWNER_ID=11111111-1111-4111-8111-111111111111
OWNER_SUBJECT=development-owner
UI_ORIGIN=http://localhost:5173
# Replace each credential independently with random values before starting.
AUTH_SIGNING_SECRET=CHANGE_ME_AUTH_32_CHARACTERS_MINIMUM
DEV_HUMAN_SECRET=CHANGE_ME_HUMAN_32_CHARACTERS_MINIMUM
DEV_MODEL_TOKEN=CHANGE_ME_MODEL_32_CHARACTERS_MINIMUM
# Optional independent worker service credential; provider uses scoped run token.
# WORKER_TOKEN=
HOST=127.0.0.1
PORT=3000
STORAGE_DRIVER=local
LOCAL_BLOB_DIR=var/blobs
CAPABILITY_MAX_AGE_MS=300000
WORKER_POLL_MS=5000
WORKER_TIMEOUT_MS=30000
# Worker disabled until ALL these values are supplied. API usage is billed separately.
# OPENAI_API_KEY=
# WORKER_MODEL=
# WORKER_MCP_URL=https://backend.example.com/mcp
# OPENAI_WEBHOOK_SECRET=
# Optional external readonly MCP: server-owned endpoint/bindings, credentials in environment.
# EXTERNAL_MCP_CONFIG=config/external-mcp.json
# DOCUMENTS_READ_TOKEN=
# Production: remove DEV_*; configure different model/UI audiences and authorized UI client.
# MODEL_JWT_ISSUER=https://issuer.example.com
# MODEL_JWT_AUDIENCE=workspace-model
# MODEL_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# UI_JWT_ISSUER=https://issuer.example.com
# UI_JWT_AUDIENCE=workspace-ui
# UI_JWKS_URL=https://issuer.example.com/.well-known/jwks.json
# UI_CLIENT_ID=workspace-pane
# Production storage uses private S3 and server IAM credentials / AWS credential chain.
# STORAGE_DRIVER=s3
# S3_BUCKET=
# AWS_REGION=
# S3_ENDPOINT=
