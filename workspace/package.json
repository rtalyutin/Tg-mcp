{
  "name": "shared-workspace-backend",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx src/main.ts",
    "build": "npm run build --workspace=shared-workspace-ui && tsc -p tsconfig.json && node scripts/build-info.mjs",
    "start": "node dist/src/main.js",
    "worker": "node --env-file-if-exists=.env --import tsx src/worker-main.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "fixture": "node --env-file-if-exists=.env --import tsx scripts/fixture.ts",
    "restore": "node --env-file-if-exists=.env --import tsx scripts/restore.ts",
    "export": "node --env-file-if-exists=.env --import tsx scripts/export.ts",
    "api:docs": "node --import tsx scripts/api-docs.ts",
    "skill:pack": "node --import tsx scripts/pack-skill.ts",
    "mcp:probe": "node --env-file-if-exists=.env --import tsx scripts/probe-mcp.ts",
    "worker:prod": "node dist/src/worker-main.js",
    "migrate:prod": "node dist/src/migrate.js",
    "format:check": "prettier --check src scripts test package.json tsconfig.json",
    "format": "prettier --write src scripts test package.json tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1143.0",
    "@js-temporal/polyfill": "0.5.1",
    "@modelcontextprotocol/sdk": "1.31.0",
    "fastify": "5.12.5",
    "jose": "6.2.12",
    "openai": "7.25.0",
    "pg": "8.23.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
