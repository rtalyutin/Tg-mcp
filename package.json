{
  "name": "telegram-story-publisher",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "schemas": "node scripts/export-schemas.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:built": "node dist/main.js",
    "start:production": "node dist/production-main.js",
    "check:config": "node dist/production-main.js --check-config",
    "secret:generate": "node scripts/generate-secret.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "jose": "6.2.12",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "7.0.2"
  }
}
