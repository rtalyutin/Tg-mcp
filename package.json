{
  "name": "telegram-story-publisher",
  "version": "0.14.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/main.ts",
    "test": "node --test test/*.test.ts",
    "check": "tsc --noEmit",
    "schemas": "node scripts/export-schemas.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/check-dashboard-assets.mjs",
    "start:built": "node dist/main.js",
    "start:production": "node dist/production-main.js",
    "check:config": "node dist/production-main.js --check-config",
    "secret:generate": "node scripts/generate-secret.mjs",
    "test:outreach": "node scripts/test-outreach.mjs",
    "outreach:admin": "node scripts/outreach-admin.ts",
    "test:dashboard": "npm test --workspace=roman-dashboard-backend"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@node-rs/argon2": "2.2.1",
    "ipaddr.js": "2.5.0",
    "jose": "6.2.12",
    "pg": "8.23.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2"
  },
  "workspaces": [
    "dashboard"
  ]
}
