{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "story_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "attempt_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "instance_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "PUBLISHED",
        "REJECTED",
        "PARTIAL",
        "UNKNOWN",
        "IN_PROGRESS"
      ]
    },
    "confirmed_messages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_index": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "message_id": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "message_url": {
            "type": "null"
          }
        },
        "required": [
          "part_index",
          "message_id",
          "message_url"
        ],
        "additionalProperties": false
      }
    },
    "uncertain_part_index": {
      "anyOf": [
        {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "remaining_parts": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "manual_check_required": {
      "type": "boolean"
    },
    "automatic_retry_allowed": {
      "type": "boolean",
      "const": false
    }
  },
  "required": [
    "story_id",
    "attempt_id",
    "instance_id",
    "status",
    "confirmed_messages",
    "uncertain_part_index",
    "remaining_parts",
    "code",
    "manual_check_required",
    "automatic_retry_allowed"
  ],
  "additionalProperties": false
}
